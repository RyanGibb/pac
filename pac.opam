# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Rocq formalization of the package calculus"
description: """
Definitions and theorem statements for a core dependency-resolution
calculus and its extensions with reductions to the core with OCaml
extraction."""
maintainer: ["Ryan Gibb"]
authors: ["Ryan Gibb"]
license: "MIT"
homepage: "https://github.com/RyanGibb/pac"
bug-reports: "https://github.com/RyanGibb/pac/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "4.14"}
  "rocq-stdlib" {>= "9.2"}
  "coq-core" {>= "9.2"}
  "pubgrub"
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/RyanGibb/pac.git"
pin-depends: [
  ["pubgrub.dev" "git+file:///home/ryan/projects/ocaml-pubgrub"]
]
