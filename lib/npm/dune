(library
 (name npm_frontend)
 (wrapped false)
 (modules npm_version berry_ext_data berry_ext npm_parse)
 (private_modules berry_ext_data)
 (libraries version yojson))

; the list as data, which berry_ext.ml parses, so that pac and the npm
; check read one file

(rule
 (target berry_ext_data.ml)
 (deps berry-extensions.json)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let json = {json|")
    (cat berry-extensions.json)
    (echo "|json}\n")))))

(library
 (name npm_solve)
 (modules encoding archive query lookup pick order solve print)
 (private_modules encoding lookup pick order)
 (libraries npm_frontend pac pac_common pubgrub unix yojson))

(test
 (name test_npm_version)
 (modules test_npm_version)
 (libraries npm_frontend))
