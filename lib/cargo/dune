(library
 (name cargo_frontend)
 (wrapped false)
 (modules cargo_version cargo_parse cargo_toml cargo_query)
 (libraries version yojson))

; wrapped, so that Order is Cargo_solve's own and not the other drivers'

(library
 (name cargo_solve)
 (modules order cargo_solve)
 ; dune's warnings, reporting rather than failing: a warning here is a
 ; note to the author, and only the extraction this links against needs
 ; them off wholesale.
 (flags
  (:standard -warn-error -a))
 (libraries cargo_frontend pac pac_common pubgrub unix))

(test
 (name test_cargo_version)
 (modules test_cargo_version)
 (libraries cargo_frontend))

(test
 (name test_cargo_solve)
 (modules test_cargo_solve)
 (deps
  (source_tree ../../test/frontends/cargo.t))
 (libraries cargo_frontend cargo_solve))
